{
  "name": "enterpriseerp-cloud",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-all.js",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix services/api run dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix services/api run build",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "start:web": "npm --prefix apps/web run start",
    "start:api": "npm --prefix services/api run start",
    "prisma:generate": "npm --prefix services/api run prisma:generate",
    "prisma:deploy": "npm --prefix services/api run prisma:deploy",
    "db:backup": "npm --prefix services/api run db:backup",
    "db:restore": "npm --prefix services/api run db:restore",
    "db:restore:validate": "npm --prefix services/api run db:restore:validate",
    "qa": "npm run build && npm run typecheck:mobile && npm --prefix services/api exec prisma validate -- --schema services/api/prisma/schema.prisma",
    "qa:security": "npm --prefix services/api run security:input-validation && npm --prefix services/api run security:rate-limit && npm --prefix services/api run security:tenant-isolation",
    "e2e:api": "npm --prefix services/api run e2e:smoke",
    "qa:mobile:device": "npm --prefix apps/mobile run start -- --clear --tunnel",
    "security:tenant-isolation": "npm --prefix services/api run security:tenant-isolation"
  }
}
