{
  "name": "enterpriseerp-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node --compiler-options \"{\\\"rootDir\\\":\\\".\\\"}\" prisma/seed.ts",
    "security:tenant-isolation": "ts-node --compiler-options \"{\\\"rootDir\\\":\\\".\\\"}\" scripts/tenant-isolation.ts",
    "security:input-validation": "ts-node --compiler-options \"{\\\"rootDir\\\":\\\".\\\"}\" scripts/input-validation.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\\\"rootDir\\\":\\\".\\\"}\" prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.3.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
