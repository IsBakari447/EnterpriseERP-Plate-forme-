generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  email     String   @unique
  country   String
  status    String
  revenue   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Product {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  sku       String   @unique
  quantity  Int      @default(0)
  status    String
  value     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Invoice {
  id        String   @id @default(cuid())
  companyId String?
  number    String   @unique
  customer  String
  amount    Float    @default(0)
  due       DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String   @default("general")
  email       String?
  phone       String?
  address     String?
  country     String?
  currency    String   @default("EUR")
  language    String   @default("fr")
  timezone    String   @default("Europe/Stockholm")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  invitations Invitation[]
  sessions    UserSession[]
  clients     Client[]
  products    Product[]
  invoices    Invoice[]
  auditLogs   AuditLog[]
}

model User {
  id           String        @id @default(cuid())
  companyId    String?
  name         String
  email        String        @unique
  passwordHash String?
  role         UserRole      @default(OWNER)
  status       UserStatus    @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     UserSession[]
  auditLogs    AuditLog[]

  @@index([companyId])
  @@index([role])
}

model UserSession {
  id           String    @id @default(cuid())
  companyId    String?
  userId       String
  refreshTokenHash String?
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  rememberMe   Boolean   @default(false)
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  email       String
  role        UserRole         @default(EMPLOYEE)
  status      InvitationStatus @default(PENDING)
  tokenHash   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  userId      String?
  module      String
  action      String
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  result      String   @default("success")
  createdAt   DateTime @default(now())
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES
  ACCOUNTING
  INVENTORY
  HR
  EMPLOYEE
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
