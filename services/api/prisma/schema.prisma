generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  email     String   @unique
  country   String
  status    String
  revenue   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Product {
  id        String   @id @default(cuid())
  companyId String?
  name      String
  sku       String   @unique
  quantity  Int      @default(0)
  status    String
  value     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Invoice {
  id        String   @id @default(cuid())
  companyId String?
  number    String   @unique
  customer  String
  amount    Float    @default(0)
  due       DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Company {
  id             String        @id @default(cuid())
  name           String
  sector         String        @default("general")
  businessType   String?
  enabledModules String[]      @default(["dashboard", "crm", "products", "inventory", "invoices", "payments", "finance", "reports", "settings", "ai"])
  email          String?
  phone          String?
  address        String?
  country        String?
  currency       String        @default("EUR")
  language       String        @default("fr")
  timezone       String        @default("Europe/Stockholm")
  dateFormat     String        @default("yyyy-MM-dd")
  numberFormat   String        @default("fr-FR")
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          User[]
  invitations    Invitation[]
  sessions       UserSession[]
  memberships    Membership[]
  roles          Role[]
  clients        Client[]
  products       Product[]
  invoices       Invoice[]
  educationStudents EducationStudent[]
  educationTeachers EducationTeacher[]
  educationClasses  EducationClass[]
  educationCourses  EducationCourse[]
  educationScheduleEntries EducationScheduleEntry[]
  educationExams EducationExam[]
  educationAttendances EducationAttendance[]
  educationSchoolFees EducationSchoolFee[]
  auditLogs      AuditLog[]
}

model EducationStudent {
  id        String   @id @default(cuid())
  companyId String
  matricule String
  firstName String
  lastName  String
  birthDate DateTime?
  gender    String?
  className String?
  level     String?
  address   String?
  guardianName String?
  phone     String?
  email     String?
  enrollmentDate DateTime?
  status    String   @default("Actif")
  photoUrl  String?
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, matricule])
  @@index([companyId])
}

model EducationTeacher {
  id        String   @id @default(cuid())
  companyId String
  teacherCode String
  firstName String
  lastName  String
  email     String?
  phone     String?
  specialty String?
  subjects  String[] @default([])
  contractType String?
  hireDate DateTime?
  salary   Float?
  classes  String[] @default([])
  availability Json?
  status   String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, teacherCode])
  @@index([companyId])
}

model EducationClass {
  id        String   @id @default(cuid())
  companyId String
  name      String
  level     String?
  capacity  Int      @default(0)
  teacherName String?
  room      String?
  status    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model EducationCourse {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  description String?
  level     String?
  subject   String?
  teacherName String?
  weeklyHours Int?
  program   String?
  status    String   @default("Actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model EducationScheduleEntry {
  id        String   @id @default(cuid())
  companyId String
  courseName String
  className  String
  teacherName String
  room      String?
  date      DateTime
  startTime String
  endTime   String
  recurrence String?
  status    String   @default("Planifie")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
}

model EducationExam {
  id        String   @id @default(cuid())
  companyId String
  title     String
  subject   String
  className String
  date      DateTime
  teacherName String?
  participants Int @default(0)
  average   Float?
  status    String   @default("Programme")
  results   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
}

model EducationAttendance {
  id        String   @id @default(cuid())
  companyId String
  studentName String
  className   String
  date        DateTime
  status      String
  justification String?
  teacherName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
}

model EducationSchoolFee {
  id        String   @id @default(cuid())
  companyId String
  studentName String
  className String?
  feeName   String
  amount    Float    @default(0)
  paid      Float    @default(0)
  dueDate   DateTime?
  status    String   @default("A relancer")
  paymentMethod String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([dueDate])
}

model User {
  id              String        @id @default(cuid())
  companyId       String?
  name            String
  firstName       String?
  lastName        String?
  email           String        @unique
  passwordHash    String?
  phone           String?
  jobTitle        String?
  department      String?
  avatarUrl       String?
  language        String        @default("fr")
  timezone        String        @default("Europe/Stockholm")
  theme           String        @default("system")
  displayCurrency String        @default("EUR")
  notificationEmail Boolean     @default(true)
  notificationErp   Boolean     @default(true)
  notificationImportant Boolean @default(true)
  signature       String?
  passwordChangedAt DateTime?
  role            UserRole      @default(OWNER)
  status          UserStatus    @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions        UserSession[]
  memberships     Membership[]
  auditLogs       AuditLog[]

  @@index([companyId])
  @@index([role])
}

model Membership {
  id         String           @id @default(cuid())
  companyId  String
  userId     String
  roleId     String?
  legacyRole UserRole         @default(EMPLOYEE)
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?
  key         String
  name        String
  description String?
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]

  @@unique([companyId, key])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id               String    @id @default(cuid())
  companyId        String?
  userId           String
  refreshTokenHash String?
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  rememberMe       Boolean   @default(false)
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

model Invitation {
  id         String           @id @default(cuid())
  companyId  String
  email      String
  role       UserRole         @default(EMPLOYEE)
  status     InvitationStatus @default(PENDING)
  tokenHash  String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  module     String
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  result     String   @default("success")
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES
  ACCOUNTING
  INVENTORY
  HR
  EMPLOYEE
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}
